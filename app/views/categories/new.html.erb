<h1>Add Category</h1>

<% if @category.errors.any? %>
  <div>
    <h2>Please fix these errors:</h2>

    <ul>
      <% @category.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @category do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name, required: true, autofocus: true %>
  </div>

  <%= form.submit "Save category" %>
<% end %>

<%= link_to "Back to categories", categories_path %>
