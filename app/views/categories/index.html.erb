<h1>Expense Categories</h1>

<%= link_to "Add category", new_category_path %>

<% if @categories.any? %>
  <ul>
    <% @categories.each do |category| %>
      <li>
        <%= category.name %>

        <% if category.default_category? %>
          <span>Default</span>
        <% else %>
          <span>Custom</span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No categories added yet.</p>
<% end %>
