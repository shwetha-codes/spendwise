<h1>Add Monthly Salary</h1>

<% if @monthly_salary.errors.any? %>
  <div>
    <h2>Please fix these errors:</h2>

    <ul>
      <% @monthly_salary.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @monthly_salary do |form| %>
  <div>
    <%= form.label :month %>
    <%= form.date_select :month,
                     discard_day: true,
                     order: [:month, :year],
                     start_year: Date.current.year - 5,
                     end_year: Date.current.year + 1 %>
  </div>

  <div>
    <%= form.label :amount %>
    <%= form.number_field :amount, step: 0.01, min: 0, required: true %>
  </div>

  <%= form.submit "Save salary" %>
<% end %>

<%= link_to "Back to salaries", monthly_salaries_path %>
